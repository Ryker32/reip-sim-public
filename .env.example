# Copy this file to .env and fill in the real values.
# .env is gitignored and must never be committed.

# SSH password for the `pi` account on the five robot Raspberry Pis.
# Used by run_trial.py, deploy_and_launch.py, and the check_*/debug_* helper
# scripts to deploy code and collect logs over the lab network.
#
# There is no default: if this variable is unset the scripts will attempt to
# authenticate with None and fail, rather than silently falling back to a
# committed value.
#
# Set it for a shell session with:
#   export REIP_ROBOT_SSH_PASSWORD='...'        # bash/zsh
#   $env:REIP_ROBOT_SSH_PASSWORD = '...'        # PowerShell
REIP_ROBOT_SSH_PASSWORD=
